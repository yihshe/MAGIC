{
    "name": "HVAE_RTM_C_AUSTRIA_s123",
    "n_gpu": 1,
    "arch": {
        "type": "PHYS_VAE",
        "args": {
            "physics": "RTM",
            "input_dim": 11,
            "hidden_dim": 7,
            "rtm_paras": "configs/rtm_paras.json",
            "standardization": {
                "x_mean": "data/processed/rtm/real/train_x_mean.npy",
                "x_scale": "data/processed/rtm/real/train_x_scale.npy"
            }
        },
        "phys_vae": {
            "no_phy": false,
            "dim_z_aux2": 2,
            "dim_z_phy": 7,
            "activation": "elu",
            "hidlayers_feat": [
                128
            ],
            "num_units_feat": 128,
            "hidlayers_aux2_enc": [
                128
            ],
            "hidlayers_z_phy": [
                128
            ]
        }
    },
    "data_loader": {
        "type": "SpectrumS2DataLoader",
        "args": {
            "data_dir": "data/processed/rtm/real/train.csv",
            "batch_size": 256,
            "shuffle": true,
            "validation_split": 0.0,
            "num_workers": 4
        },
        "data_dir_valid": "data/processed/rtm/real/valid.csv",
        "data_dir_test": "data/processed/rtm/real/test.csv"
    },
    "optimizer": {
        "type": "Adam",
        "args": {
            "lr": 0.0003,
            "weight_decay": 0.0001,
            "amsgrad": true
        }
    },
    "loss": "mse_loss",
    "metrics": [],
    "lr_scheduler": {
        "type": "CosineAnnealingLR",
        "args": {
            "T_max": 150
        }
    },
    "trainer": {
        "epochs": 150,
        "save_dir": "saved/rebuttal/seed_variance",
        "save_period": 10,
        "log_step": 5,
        "verbosity": 2,
        "monitor": "min val_loss",
        "early_stop": 100,
        "input_key": "spectrum",
        "output_key": "spectrum",
        "stablize_grad": true,
        "tensorboard": false,
        "wandb": false,
        "phys_vae": {
            "epochs_pretrain": 0,
            "x_lnvar": -9.0,
            "balance_kld": 1,
            "balance_lact_enc": 0.01,
            "balance_unmix": 0.01,
            "balance_data_aug": 0.01,
            "balance_lact_dec": 0.01
        }
    },
    "seed": 123
}